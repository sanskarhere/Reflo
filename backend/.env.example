# Razorpay test-mode keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# xAI API key for the decision agent (Grok, OpenAI-compatible endpoint)
# Get one at console.x.ai — free trial credits available.
XAI_API_KEY=xai-xxxxxxxxxxxxxxxx

# Local dev DB — leave unset to use the sqlite default; Render sets its own
# DATABASE_URL automatically via the linked Postgres instance in render.yaml
# DATABASE_URL=sqlite:///./recovery.db

# Shared secret protecting POST /admin/run-batch (no shell access on Render free tier)
ADMIN_SECRET=choose-a-random-string-here
